--- !u!114 &1797972566233663281
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1797972566233663280}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 941c95505295a984f998fe8a047ce13a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CatCircuit.CircuitPuzzle
  circuit: {fileID: 1797972566233663278}
  progressId: 1
  stages:
  - name: Closed circuit
    objective: "\u0421\u043B\u043E\u0436\u0438 \u0431\u0430\u0442\u0435\u0440\u0438\u044F\u0442\u0430
      \u0438 \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440\u0430 \u0432 \u043F\u0440\u0430\u0437\u043D\u0438\u0442\u0435
      \u043C\u0435\u0441\u0442\u0430!"
    conditions:
    - type: 0
      targets: L1
      min: 0
      max: 0
      count: 1
      partKind: 2
      component: {fileID: 0}
      invert: 0
    successMessage: "LED-\u044A\u0442 \u0441\u0432\u0435\u0442\u043D\u0430! \u0413\u043E\u0432\u043E\u0440\u0438
      \u0441 Professor Whiskers."
    completeDialogue:
    - "\u0411\u0440\u0430\u0432\u043E! LED-\u044A\u0442 \u0441\u0432\u0435\u0442\u043D\u0430!
      \u0417\u0430\u0442\u0432\u043E\u0440\u0438 \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430."
    - "\u0411\u0430\u0442\u0435\u0440\u0438\u044F\u0442\u0430 \u0431\u0443\u0442\u0430
      \u0442\u043E\u043A\u0430, \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440\u044A\u0442
      \u043F\u0440\u0435\u0434\u043F\u0430\u0437\u0432\u0430 LED-\u0430 \u0434\u0430
      \u043D\u0435 \u0438\u0437\u0433\u043E\u0440\u0438."
    - "\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0442\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u043E:
      \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430 \u0432\u0438\u043D\u0430\u0433\u0438
      \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430 \u0435 \u0437\u0430\u0442\u0432\u043E\u0440\u0435\u043D
      \u043A\u0440\u044A\u0433."
    hints:
    - when:
      - type: 8
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 0
      message: "\u0422\u0432\u044A\u0440\u0434\u0435 \u043C\u043D\u043E\u0433\u043E
        \u0442\u043E\u043A \u2013 LED-\u044A\u0442 \u0449\u0435 \u0438\u0437\u0433\u043E\u0440\u0438!"
    - when:
      - type: 9
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 0
      message: "LED-\u044A\u0442 \u0435 \u043E\u0431\u044A\u0440\u043D\u0430\u0442
        \u043D\u0430\u043E\u0431\u0440\u0430\u0442\u043D\u043E! \u0417\u0430\u0432\u044A\u0440\u0442\u0438
        \u0433\u043E \u0441 R."
    - when:
      - type: 12
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 1
      message: "\u0412\u0435\u0440\u0438\u0433\u0430\u0442\u0430 \u043D\u0435 \u0435
        \u0437\u0430\u0442\u0432\u043E\u0440\u0435\u043D\u0430 \u2013 \u043E\u0449\u0435
        \u043D\u0435\u0449\u043E \u043B\u0438\u043F\u0441\u0432\u0430!"
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  sparkleOnComplete: 1
  completeEffect: {fileID: 0}
  sparkMaterial: {fileID: 2100000, guid: 26ec46b508a66b645a02c2c39b3a64b1, type: 2}
