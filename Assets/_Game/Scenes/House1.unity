  m_Script: {fileID: 11500000, guid: 5ff0606b52028ad46bc194303d9a610d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CatNPC
  interactPriority: 0
  npcName: Professor Whiskers
  puzzle: {fileID: 1797972566233663281}
  greetingDialogue:
  - "\u0417\u0434\u0440\u0430\u0432\u0435\u0439, \u043C\u043B\u0430\u0434 \u043A\u043E\u0442\u0430\u0440\u0430\u043A!
    \u0410\u0437 \u0441\u044A\u043C \u043F\u0440\u043E\u0444\u0435\u0441\u043E\u0440
    \u041C\u044A\u0440."
  - "\u0422\u0440\u044F\u0431\u0432\u0430 \u043C\u0438 \u043F\u043E\u043C\u043E\u0449
    \u0441 \u0442\u0430\u0437\u0438 \u0432\u0435\u0440\u0438\u0433\u0430. \u0412\u0438\u0436
    ... \u0438\u043C\u0430 \u0434\u0432\u0435 \u043F\u0440\u0430\u0437\u043D\u0438
    \u043C\u0435\u0441\u0442\u0430."
  - "\u0415\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u0442\u043E
    \u0438\u043C\u0430 \u043D\u0443\u0436\u0434\u0430 \u043E\u0442 \u043F\u044A\u043B\u0435\u043D
    \u043A\u0440\u044A\u0433, \u0437\u0430 \u0434\u0430 \u0442\u0435\u0447\u0435.
    \u041A\u0430\u0442\u043E \u043F\u0438\u0441\u0442\u0430 \u0437\u0430 \u0441\u044A\u0441\u0442\u0435\u0437\u0430\u043D\u0438\u0435
    \u2014 \u0430\u043A\u043E \u0438\u043C\u0430 \u0434\u0443\u043F\u043A\u0430,
    \u043D\u0435 \u0441\u0442\u0430\u0432\u0430!"
  - "\u0421\u043B\u043E\u0436\u0438 \u0411\u0430\u0442\u0435\u0440\u0438\u044F\u0442\u0430
    \u0437\u0430 \u043C\u043E\u0449\u043D\u043E\u0441\u0442 \u0438 \u0420\u0435\u0437\u0438\u0441\u0442\u043E\u0440\u0430
    \u0434\u0430 \u043F\u0430\u0437\u0438 LED-\u0430. \u0422\u0435 \u0441\u0430 \u043D\u044F\u043A\u044A\u0434\u0435
    \u043D\u0430 \u0431\u044E\u0440\u043E\u0442\u043E."
