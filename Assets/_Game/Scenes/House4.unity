    \u0421\u0415\u0420\u0418\u0419\u041D\u0418\u0422\u0415 \u0441\u043B\u043E\u0442\u043E\u0432\u0435!"
  - "\u0429\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043C \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u043D\u0430
    \u0432\u0435\u0440\u0438\u0433\u0430 \u2014 \u0442\u043E\u043A\u044A\u0442 \u043C\u0438\u043D\u0430\u0432\u0430
    \u043F\u0440\u0435\u0437 \u0432\u0441\u0435\u043A\u0438 LED \u0435\u0434\u0438\u043D
