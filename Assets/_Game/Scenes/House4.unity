--- !u!114 &1797972566233663281
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1797972566233663279}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 941c95505295a984f998fe8a047ce13a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CatCircuit.CircuitPuzzle
  circuit: {fileID: 1797972566233663280}
  progressId: 4
  stages:
  - name: Series
    objective: "\u0421\u043B\u043E\u0436\u0438 \u0442\u0440\u0438\u0442\u0435 LED-\u0430
      \u0432 \u0441\u0438\u043D\u0438\u0442\u0435 \u0441\u043B\u043E\u0442\u043E\u0432\u0435
      \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u043D\u0430
      \u0432\u0435\u0440\u0438\u0433\u0430!"
    conditions:
    - type: 0
      targets: S1,S2,S3
      min: 0
      max: 0
      count: 1
      partKind: 2
      component: {fileID: 0}
      invert: 0
    successMessage: "\u041F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u043D\u0430
      \u0432\u0435\u0440\u0438\u0433\u0430! \u0413\u043E\u0432\u043E\u0440\u0438
      \u0441 \u043A\u043E\u0442\u0435\u0442\u0430\u0442\u0430!"
    completeDialogue:
    - "\u0411\u0440\u0430\u0432\u043E! \u041D\u0430\u043F\u0440\u0430\u0432\u0438
      \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u043D\u0430
      \u0432\u0435\u0440\u0438\u0433\u0430!"
    - "\u0412\u0438\u0436\u0434\u0430\u0448 \u043B\u0438 \u043A\u0430\u043A \u043F\u044A\u0440\u0432\u0438\u044F\u0442
      LED \u0435 \u043D\u0430\u0439-\u044F\u0440\u044A\u043A, \u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u044F\u0442
      \u2014 \u043D\u0430\u0439-\u0441\u043B\u0430\u0431?"
    - "\u0421\u0435\u0433\u0430 \u043F\u0440\u0435\u043C\u0435\u0441\u0442\u0438
      \u0434\u0432\u0430 LED-\u0430 \u0432 \u041F\u0410\u0420\u0410\u041B\u0415\u041B\u041D\u0418\u0422\u0415
      \u0441\u043B\u043E\u0442\u043E\u0432\u0435!"
    - "\u0429\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043C \u0443\u0441\u043F\u043E\u0440\u0435\u0434\u043D\u0430
      \u0432\u0435\u0440\u0438\u0433\u0430 \u2014 \u0432\u0441\u0435\u043A\u0438
      LED \u0438\u043C\u0430 \u0441\u0432\u043E\u0439 \u043F\u044A\u0442!"
    hints: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - name: Parallel
    objective: "\u041F\u0440\u0435\u043C\u0435\u0441\u0442\u0438 \u0434\u0432\u0430
      LED-\u0430 \u0432 \u0443\u0441\u043F\u043E\u0440\u0435\u0434\u043D\u0438\u0442\u0435
      \u0441\u043B\u043E\u0442\u043E\u0432\u0435!"
    conditions:
    - type: 0
      targets: S4,S5
      min: 0
      max: 0
      count: 1
      partKind: 2
      component: {fileID: 0}
      invert: 0
    - type: 2
      targets: S1,S2,S3
      min: 0
      max: 0
      count: 1
      partKind: 2
      component: {fileID: 0}
      invert: 0
    successMessage: "\u0423\u0441\u043F\u043E\u0440\u0435\u0434\u043D\u0430 \u0432\u0435\u0440\u0438\u0433\u0430!
      \u0413\u043E\u0432\u043E\u0440\u0438 \u0441 \u043A\u043E\u0442\u0435\u0442\u0430\u0442\u0430!"
    completeDialogue:
    - "\u0421\u0443\u043F\u0435\u0440! \u0421\u0435\u0433\u0430 \u0438 \u0442\u0440\u0438\u0442\u0435
      \u0441\u0432\u0435\u0442\u044F\u0442 \u0435\u0434\u043D\u0430\u043A\u0432\u043E
      \u044F\u0440\u043A\u043E!"
    - "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u043D\u0430
      \u0432\u0435\u0440\u0438\u0433\u0430 \u0434\u0435\u043B\u044F\u0442 \u043D\u0430\u043F\u0440\u0435\u0436\u0435\u043D\u0438\u0435\u0442\u043E
      \u2014 \u0437\u0430\u0442\u043E\u0432\u0430 \u0441\u0430 \u043D\u0435\u0440\u0430\u0432\u043D\u0438."
    - "\u0412 \u0443\u0441\u043F\u043E\u0440\u0435\u0434\u043D\u0430 \u0432\u0435\u0440\u0438\u0433\u0430
      \u0432\u0441\u0435\u043A\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0432\u0430
      \u043F\u044A\u043B\u043D\u043E\u0442\u043E \u043D\u0430\u043F\u0440\u0435\u0436\u0435\u043D\u0438\u0435
      \u2014 \u0440\u0430\u0432\u043D\u0438 \u0441\u0430!"
    - "\u0417\u0430\u0442\u043E\u0432\u0430 \u043B\u0430\u043C\u043F\u0438\u0442\u0435
      \u0432\u043A\u044A\u0449\u0438 \u0441\u0430 \u0443\u0441\u043F\u043E\u0440\u0435\u0434\u043D\u0438
      \u2014 \u0432\u0441\u0438\u0447\u043A\u0438 \u0441\u0432\u0435\u0442\u044F\u0442
      \u0435\u0434\u043D\u0430\u043A\u0432\u043E!"
    - "\u0418\u0434\u0438 \u043F\u0440\u0438 \u043A\u043C\u0435\u0442\u0430 \u0424\u043B\u044A\u0444\u0438\u043D\u0433\u0442\u044A\u043D!
      \u0422\u043E\u0439 \u0442\u0435 \u0447\u0430\u043A\u0430 \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0430\u0442\u0430
      \u0437\u0430\u0434\u0430\u0447\u0430!"
    hints: []
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  sparkleOnComplete: 1
