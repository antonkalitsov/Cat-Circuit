  npcName: "\u041A\u043E\u0442\u0435\u0442\u0430"
  puzzle: {fileID: 1797972566233663281}
  greetingDialogue:
  - "\u041C\u044F\u0443! \u0417\u0434\u0440\u0430\u0441\u0442\u0438! \u041D\u0438\u0435
    \u0441\u043C\u0435 \u043A\u043E\u0442\u0435\u0442\u0430\u0442\u0430!"
  - "\u0418\u0441\u043A\u0430\u0448 \u043B\u0438 \u0434\u0430 \u0441\u0438 \u043F\u043E\u0438\u0433\u0440\u0430\u0435\u043C
