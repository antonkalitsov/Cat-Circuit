  m_Script: {fileID: 11500000, guid: 941c95505295a984f998fe8a047ce13a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CatCircuit.CircuitPuzzle
  circuit: {fileID: 771478843}
  progressId: 5
  stages:
  - name: First LED
    objective: "\u041D\u0430\u043F\u0438\u0448\u0438 \u0432\u0435\u0440\u0438\u0433\u0430
      \u0441 \u0431\u0430\u0442\u0435\u0440\u0438\u044F, \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440
      \u0438 LED. LED-\u044A\u0442 \u0442\u0440\u044F\u0431\u0432\u0430 \u0434\u0430
      \u0441\u0432\u0435\u0442\u0438, \u0431\u0435\u0437 \u0434\u0430 \u0438\u0437\u0433\u0430\u0440\u044F."
    conditions:
    - type: 2
      targets: 
      min: 0
      max: 0
      count: 1
      partKind: 2
      component: {fileID: 0}
      invert: 0
    - type: 7
      targets: 
      min: 0
      max: 0
      count: 1
      partKind: 2
      component: {fileID: 0}
      invert: 0
    successMessage: "\u041F\u044A\u0440\u0432\u0430\u0442\u0430 \u0442\u0438 \u0432\u0435\u0440\u0438\u0433\u0430
      \u043E\u0442 \u043A\u043E\u0434 \u0440\u0430\u0431\u043E\u0442\u0438! \u0413\u043E\u0432\u043E\u0440\u0438
      \u0441 \u043A\u043C\u0435\u0442\u0430."
    completeDialogue:
    - "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u041A\u043C\u0435\u0442\u0441\u0442\u0432\u043E\u0442\u043E
      \u0435 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u043E."
    - "\u0411\u0430\u0442\u0435\u0440\u0438\u044F\u0442\u0430 \u0431\u0443\u0442\u0430
      \u0442\u043E\u043A\u0430, \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440\u044A\u0442
      \u0433\u043E \u043F\u0430\u0437\u0438, \u0430 LED-\u044A\u0442 \u0441\u0432\u0435\u0442\u0438."
    - "\u041D\u043E \u0441\u0435\u0433\u0430 \u0449\u0435 \u0441\u0442\u0430\u043D\u0435
      \u043F\u043E-\u0442\u0440\u0443\u0434\u043D\u043E..."
    hints:
    - when:
      - type: 10
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 0
      message: "\u041A\u044A\u0441\u043E \u0441\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435!
        \u0422\u043E\u043A\u044A\u0442 \u0442\u0435\u0447\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043E
        \u043E\u0442 + \u043A\u044A\u043C -. \u0421\u043B\u043E\u0436\u0438 \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440
        \u0438 LED \u043F\u043E \u043F\u044A\u0442\u044F."
    - when:
      - type: 8
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 0
      message: "LED-\u044A\u0442 \u0438\u0437\u0433\u0430\u0440\u044F! \u0414\u043E\u0431\u0430\u0432\u0438
        \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440 (\u043D\u0430\u043F\u0440.
        330), \u0437\u0430 \u0434\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0448
        \u0442\u043E\u043A\u0430."
    - when:
      - type: 9
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 0
      message: "LED-\u044A\u0442 \u0435 \u043E\u0431\u044A\u0440\u043D\u0430\u0442
        \u2013 \u0442\u043E\u043A\u044A\u0442 \u0442\u0440\u044F\u0431\u0432\u0430
        \u0434\u0430 \u0432\u043B\u0438\u0437\u0430 \u0432 \u043D\u0435\u0433\u043E\u0432\u0438\u044F
        + (\u0434\u044A\u043B\u0433\u043E\u0442\u043E \u043A\u0440\u0430\u0447\u0435)."
    - when:
      - type: 11
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 0
      message: "\u041D\u0435 \u0442\u0435\u0447\u0435 \u0442\u043E\u043A. \u0417\u0430\u0442\u0432\u043E\u0440\u0438
        \u043A\u0440\u044A\u0433\u0430: \u0437\u0430\u043F\u043E\u0447\u043D\u0438
        \u043E\u0442 B+ \u0438 \u0437\u0430\u0432\u044A\u0440\u0448\u0438 \u0432
        B-."
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - name: Only 3 volts
    objective: "\u0418\u043C\u0430\u043C\u0435 \u0441\u0430\u043C\u043E \u0431\u0430\u0442\u0435\u0440\u0438\u044F
      \u043E\u0442 3V. \u041D\u0430\u043F\u0440\u0430\u0432\u0438 \u0442\u0430\u043A\u0430,
      \u0447\u0435 \u0414\u0412\u0410 LED-\u0430 \u0434\u0430 \u0441\u0432\u0435\u0442\u044F\u0442
      \u0435\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E."
    conditions:
    - type: 14
      targets: 
      min: 0
      max: 3
      count: 1
      partKind: 2
      component: {fileID: 0}
      invert: 0
    - type: 3
      targets: 
      min: 0
      max: 0
      count: 2
      partKind: 2
      component: {fileID: 0}
      invert: 0
    - type: 7
      targets: 
      min: 0
      max: 0
      count: 1
      partKind: 2
      component: {fileID: 0}
      invert: 0
    successMessage: "\u0414\u0432\u0430\u0442\u0430 LED-\u0430 \u0441\u0432\u0435\u0442\u044F\u0442!
      \u0413\u043E\u0432\u043E\u0440\u0438 \u0441 \u043A\u043C\u0435\u0442\u0430."
    completeDialogue:
    - "\u0411\u0440\u0430\u0432\u043E! \u0422\u043E\u0432\u0430 \u0435 \u0443\u0441\u043F\u043E\u0440\u0435\u0434\u043D\u043E
      \u0441\u0432\u044A\u0440\u0437\u0432\u0430\u043D\u0435."
    - "\u0412\u0441\u0435\u043A\u0438 LED \u043F\u043E\u043B\u0443\u0447\u0430\u0432\u0430
      \u043F\u044A\u043B\u043D\u0438\u0442\u0435 3V, \u0437\u0430\u0442\u043E\u0432\u0430
      \u0438 \u0434\u0432\u0430\u0442\u0430 \u0441\u0432\u0435\u0442\u044F\u0442."
    - "\u041F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u043D\u043E
      \u0449\u044F\u0445\u0430 \u0434\u0430 \u0441\u0438 \u0434\u0435\u043B\u044F\u0442
      \u043D\u0430\u043F\u0440\u0435\u0436\u0435\u043D\u0438\u0435\u0442\u043E \u2013
      \u0438 \u043D\u044F\u043C\u0430\u0448\u0435 \u0434\u0430 \u0441\u0442\u0438\u0433\u043D\u0435."
    hints:
    - when:
      - type: 14
        targets: 
        min: 0
        max: 3
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 1
      message: "\u0411\u0430\u0442\u0435\u0440\u0438\u044F\u0442\u0430 \u0442\u0440\u044F\u0431\u0432\u0430
        \u0434\u0430 \u0435 \u043D\u0430\u0439-\u043C\u043D\u043E\u0433\u043E 3V,
        \u043D\u0430\u043F\u0440.: battery B 3V"
    - when:
      - type: 10
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 0
      message: "\u041A\u044A\u0441\u043E \u0441\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435!
        \u0422\u043E\u043A\u044A\u0442 \u0442\u0435\u0447\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043E
        \u043E\u0442 + \u043A\u044A\u043C -. \u0421\u043B\u043E\u0436\u0438 \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440
        \u0438 LED \u043F\u043E \u043F\u044A\u0442\u044F."
    - when:
      - type: 8
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 0
      message: "LED-\u044A\u0442 \u0438\u0437\u0433\u0430\u0440\u044F! \u0414\u043E\u0431\u0430\u0432\u0438
        \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440 (\u043D\u0430\u043F\u0440.
        330), \u0437\u0430 \u0434\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0448
        \u0442\u043E\u043A\u0430."
    - when:
      - type: 9
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 2
        component: {fileID: 0}
        invert: 0
      message: "LED-\u044A\u0442 \u0435 \u043E\u0431\u044A\u0440\u043D\u0430\u0442
        \u2013 \u0442\u043E\u043A\u044A\u0442 \u0442\u0440\u044F\u0431\u0432\u0430
        \u0434\u0430 \u0432\u043B\u0438\u0437\u0430 \u0432 \u043D\u0435\u0433\u043E\u0432\u0438\u044F
        + (\u0434\u044A\u043B\u0433\u043E\u0442\u043E \u043A\u0440\u0430\u0447\u0435)."
    - when:
      - type: 15
