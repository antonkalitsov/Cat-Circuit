        component: {fileID: 0}
        invert: 0
      - type: 3
        targets: 
        min: 0
        max: 0
        count: 2
        partKind: 2
        component: {fileID: 0}
        invert: 1
      message: "\u0414\u0432\u0430 LED-\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u043D\u043E
        \u0438\u0441\u043A\u0430\u0442 3.6V \u2013 3V \u043D\u0435 \u0441\u0442\u0438\u0433\u0430\u0442!
        \u0414\u0430\u0439 \u043D\u0430 \u0432\u0441\u0435\u043A\u0438 LED \u0441\u0432\u043E\u0439
        \u043F\u044A\u0442 (\u0443\u0441\u043F\u043E\u0440\u0435\u0434\u043D\u043E)."
    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - name: Master switch
    objective: "\u0414\u043E\u0431\u0430\u0432\u0438 \u043A\u043B\u044E\u0447 (switch),
      \u043A\u043E\u0439\u0442\u043E \u0433\u0430\u0441\u0438 \u0412\u0421\u0418\u0427\u041A\u0418
      LED-\u043E\u0432\u0435 \u043D\u0430\u0432\u0435\u0434\u043D\u044A\u0436. \u0429\u0440\u0430\u043A\u0430\u0448
      \u0433\u043E \u0441 E."
    conditions:
    - type: 16
      targets: 
      min: 0
      max: 0
      count: 1
      partKind: 2
      component: {fileID: 0}
      invert: 0
    - type: 15
      targets: 
      min: 0
      max: 0
      count: 2
      partKind: 2
      component: {fileID: 0}
      invert: 0
    successMessage: "\u0413\u043B\u0430\u0432\u043D\u0438\u044F\u0442 \u043A\u043B\u044E\u0447
      \u0440\u0430\u0431\u043E\u0442\u0438! \u0413\u043E\u0432\u043E\u0440\u0438
      \u0441 \u043A\u043C\u0435\u0442\u0430."
    completeDialogue:
    - "\u0412\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u043E! \u0422\u0438
      \u0441\u0438 \u0438\u0441\u0442\u0438\u043D\u0441\u043A\u0438 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u0442\u0435\u0445\u043D\u0438\u043A!"
    - "\u041A\u043B\u044E\u0447\u044A\u0442 \u043F\u0440\u0435\u043A\u044A\u0441\u0432\u0430
      \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430 \u2013 \u0431\u0435\u0437
      \u0437\u0430\u0442\u0432\u043E\u0440\u0435\u043D \u043A\u0440\u044A\u0433 \u043D\u044F\u043C\u0430
      \u0442\u043E\u043A."
    - "\u0421\u0435\u043B\u043E\u0442\u043E \u0441\u0435 \u0433\u043E\u0440\u0434\u0435\u0435
      \u0441 \u0442\u0435\u0431! \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u0442\u0438!"
    hints:
    - when:
      - type: 15
        targets: 
        min: 0
        max: 0
        count: 1
        partKind: 4
        component: {fileID: 0}
        invert: 1
      message: "\u0414\u043E\u0431\u0430\u0432\u0438 \u043A\u043B\u044E\u0447, \u043D\u0430\u043F\u0440.:
        switch S1 on \u2013 \u0438 \u0433\u043E \u0441\u043B\u043E\u0436\u0438 \u0432
        \u043F\u044A\u0442\u044F \u043D\u0430 \u0442\u043E\u043A\u0430."
    - when:
      - type: 15
