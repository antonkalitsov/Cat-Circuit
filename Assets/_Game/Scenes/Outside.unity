  npcName: "\u0421\u043F\u0430\u0440\u043A\u0438"
  puzzle: {fileID: 0}
  greetingDialogue:
  - "\u041E, \u0437\u0434\u0440\u0430\u0441\u0442\u0438! \u041D\u0430\u043C\u0435\u0440\u0438
    \u043C\u0435! \u0410\u0437 \u0441\u044A\u043C \u0421\u043F\u0430\u0440\u043A\u0438."
  - "\u0421\u0442\u0430\u0440 \u0422\u043E\u043C \u043C\u0435 \u0434\u044A\u0440\u0436\u0438
    \u0442\u0443\u043A \u0434\u0430 \u043D\u0435 \u043F\u0440\u0435\u0447\u0430 \u0441
    \u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0442\u0435 \u0441\u0438."
  - "\u0420\u0435\u0448\u0438 \u0437\u0430\u0434\u0430\u0447\u0430\u0442\u0430 \u0441
    \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440\u0438\u0442\u0435 \u043F\u0440\u0438
    \u0422\u043E\u043C \u0438 \u043F\u043E\u0441\u043B\u0435 \u0435\u043B\u0430 \u043F\u0430\u043A!"
  unlockedAfterPuzzle: 3
  unlockedDialogue:
  - "\u0411\u0440\u0430\u0432\u043E! \u0420\u0435\u0448\u0438 \u0437\u0430\u0434\u0430\u0447\u0430\u0442\u0430!
    \u0421\u0435\u0433\u0430 \u0449\u0435 \u0442\u0438 \u043F\u043E\u043A\u0430\u0436\u0430
    \u043D\u0435\u0449\u043E \u044F\u043A\u043E."
  - "\u0422\u043E\u0432\u0430 \u0435 \u0437\u0430\u043A\u043E\u043D\u044A\u0442 \u043D\u0430
    \u041E\u043C:"
  - "U = I \xD7 R"
  - "U \u0435 \u043D\u0430\u043F\u0440\u0435\u0436\u0435\u043D\u0438\u0435 \u2014
    \u043A\u043E\u043B\u043A\u043E \u0441\u0438\u043B\u043D\u043E \u0431\u0443\u0442\u0430
    \u0442\u043E\u043A\u0430. \u041C\u0435\u0440\u0438 \u0441\u0435 \u0432\u044A\u0432
    \u0432\u043E\u043B\u0442\u043E\u0432\u0435 (V)."
  - "I \u0435 \u0442\u043E\u043A \u2014 \u043A\u043E\u043B\u043A\u043E \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0442\u0435\u0447\u0435. \u041C\u0435\u0440\u0438 \u0441\u0435 \u0432 \u0430\u043C\u043F\u0435\u0440\u0438
    (A)."
  - "R \u0435 \u0441\u044A\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
    \u2014 \u043A\u043E\u043B\u043A\u043E \u0441\u0435 \u0441\u044A\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0432\u0430
    \u0432\u0435\u0440\u0438\u0433\u0430\u0442\u0430. \u041C\u0435\u0440\u0438 \u0441\u0435
    \u0432 \u043E\u043C\u043E\u0432\u0435 (\u03A9)."
  - "\u041F\u0440\u0438\u043C\u0435\u0440: \u0410\u043A\u043E \u0431\u0430\u0442\u0435\u0440\u0438\u044F\u0442\u0430
    \u0435 9V \u0438 \u0438\u0441\u043A\u0430\u0448 \u0442\u043E\u043A 0.02A \u0437\u0430
    \u0435\u0434\u0438\u043D LED..."
  - "R = U \xF7 I = 9 \xF7 0.02 = 450\u03A9"
  - "\u0417\u043D\u0430\u0447\u0438 \u0442\u0438 \u0442\u0440\u044F\u0431\u0432\u0430
    \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440 \u043E\u043A\u043E\u043B\u043E
    450 \u043E\u043C\u0430, \u0437\u0430 \u0434\u0430 \u0441\u0432\u0435\u0442\u0438
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E!"
  - "\u041F\u043E-\u043C\u0430\u043B\u044A\u043A \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440
    = \u043F\u043E\u0432\u0435\u0447\u0435 \u0442\u043E\u043A = \u043F\u043E-\u044F\u0440\u043A\u043E,
    \u043D\u043E \u043E\u043F\u0430\u0441\u043D\u043E."
  - "\u041F\u043E-\u0433\u043E\u043B\u044F\u043C \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440
    = \u043F\u043E-\u043C\u0430\u043B\u043A\u043E \u0442\u043E\u043A = \u043F\u043E-\u0442\u044A\u043C\u043D\u043E,
    \u043D\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E."
  - "\u0422\u043E\u0432\u0430 \u0435! \u0421\u0435\u0433\u0430 \u0437\u043D\u0430\u0435\u0448
    \u043A\u0430\u043A \u0434\u0430 \u0438\u0437\u0431\u0438\u0440\u0430\u0448 \u0440\u0435\u0437\u0438\u0441\u0442\u043E\u0440\u0438.
    \u041A\u044A\u0441\u043C\u0435\u0442!"
  OnQuestAccepted:
    m_PersistentCalls:
      m_Calls: []
  OnQuestCompleted:
    m_PersistentCalls:
      m_Calls: []
